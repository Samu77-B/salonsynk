# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
# Platform subscriptions (monthly GBP) — see docs/STRIPE_SUBSCRIPTION_SETUP.md
# Payouts go to the Stripe account for STRIPE_SECRET_KEY (not Connect). Enable Customer Portal: Dashboard → Settings → Billing → Customer portal.
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_COMPLETE=
STRIPE_PRICE_ESSENTIALS_YEARLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_COMPLETE_YEARLY=
# Legacy single price (£50/mo) — maps to Professional if STRIPE_PRICE_PROFESSIONAL is unset
STRIPE_FLAT_FEE_PRICE_ID=
STRIPE_FLAT_FEE_PRODUCT_ID=
# BarberSynk and NailSynk platform subscriptions (£25/month; optional yearly)
STRIPE_PRICE_BARBER=
STRIPE_PRICE_BARBER_YEARLY=
STRIPE_PRICE_NAIL=
STRIPE_PRICE_NAIL_YEARLY=

# Resend (transactional email)
RESEND_API_KEY=
# From address - use a verified domain (e.g. noreply@salonsynk.com) to send to any recipient. onboarding@resend.dev only allows your own email.
# RESEND_FROM_ADDRESS=SalonSynk <noreply@salonsynk.com>

# Optional: SMS and WhatsApp (Twilio) for reminders and review requests
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=       # E.164 e.g. +441234567890
# TWILIO_WHATSAPP_NUMBER=    # E.164 or whatsapp:+14155238886 (sandbox)

# App URL for invite emails and redirects (set in Vercel for production)
# NEXT_PUBLIC_APP_URL=https://salonsynk.vercel.app

# Optional: secure cron endpoints (reminders, review requests, we-miss-you). Pass as Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Optional future: AI voice (Vapi or Retell) for phone booking
# VAPI_API_KEY=
# RETELL_API_KEY=

# PaySynk master-admin API (server-only — never NEXT_PUBLIC_)
# Copy SMARTSYNK_API_KEY from the PaySynk app .env into PAYSYNK_ADMIN_API_KEY.
# Local: PaySynk origin (this repo is often on :3001 if PaySynk uses :3000).
# Production: use www so the Bearer token is not dropped on the apex → www redirect.
# PAYSYNK_ADMIN_API_URL=http://localhost:3000
# PAYSYNK_ADMIN_API_URL=https://www.paysynk.com
# PAYSYNK_ADMIN_API_KEY=
